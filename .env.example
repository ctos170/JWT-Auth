# Application and database
PROJECT_NAME=JWT Authentication API
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jwt_auth
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/test_db
DB_ECHO=false

# SMTP (submission with STARTTLS; use the settings required by your provider)
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=you@example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Frontend URL used to build password reset links
FRONTEND_BASE_URL=https://your-frontend.example.com

# Refresh token cookie (requires HTTPS when Secure is true)
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
# Set this only when the frontend and API need a shared parent domain.
# REFRESH_COOKIE_DOMAIN=.example.com

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=15
